{
  "name": "talha-bahtiyar-agentic-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache playwright test",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache playwright test --ui",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "test:install": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache playwright install chromium webkit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@11.25.0"
}
